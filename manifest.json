{
  "manifest_version": 3,
  "name": "Spot2About",
  "version": "2.0.0",
  "description": "Automatically sync your Spotify music to your WhatsApp About.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://open.spotify.com/*", "https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {"matches": ["https://open.spotify.com/*"], "js": ["spotify.js"], "run_at": "document_idle"},
    {"matches": ["https://web.whatsapp.com/*"], "js": ["whatsapp.js"], "run_at": "document_idle"}
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spot2About",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  }
}
